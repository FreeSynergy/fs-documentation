# Git internals – stay out of search results
.git/

# MkDocs build output (rebuilt locally / by CI, not source)
site/
.mkdocs-cache/

# Python caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Temporary working scripts
scripts/_tmp_*.py

# Third-party tool downloads / research artifacts (not source)
.research-planner/
*.tmp

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
